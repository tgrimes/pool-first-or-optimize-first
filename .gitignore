.Rproj.user/
.Rhistory
.RData
.DS_Store

# Quarto build output
/.quarto/
/manuscript/.quarto/
/manuscript/*_files/
/manuscript/*.html
/manuscript/*.pdf
/manuscript/*.docx

# Large inputs are not committed. Record where to get them in README.md.
# Uncomment to keep raw data out of git:
# /data/raw/*
# !/data/raw/.gitkeep

# Python environment and caches (uv manages .venv/; uv.lock is committed)
/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Per-replicate simulation output (large, regenerated by the scripts); the per-cell summaries are committed
**/results/*_replicates.rds

# Rendered deliverables are rebuilt from their sources
/background/*.html
/background/*_files/
/pilot*/*.html
/pilot*/*_files/
